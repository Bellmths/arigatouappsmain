---
// 日本語のアプリ個別LP（/apps/<id>）。apps データから全アプリ分を静的生成する。
import BaseLayout from "../../layouts/BaseLayout.astro";
import AppLanding from "../../components/AppLanding.astro";
import { apps } from "../../data/apps";
import type { AndroidAppWithUrl } from "../../data/apps";
import { appJsonLd } from "../../lib/structuredData";
import { site } from "../../data/site";
import { appSeoTitle } from "../../data/seo";
import { t, tList } from "../../i18n";

export function getStaticPaths() {
  return apps.map((app) => ({ params: { id: app.id }, props: { app } }));
}

interface Props {
  app: AndroidAppWithUrl;
}
const { app } = Astro.props;
const lang = "ja";

const title = appSeoTitle[app.id]?.[lang] ?? app.name;
// meta description は説明＋特徴1点でやや長く（キーワードも増える）。
const feats = app.features ? tList(app.features, lang) : [];
const description = [t(app.desc, lang), feats[0]].filter(Boolean).join(" ");
const image = app.icon ? `${site.url}${app.icon}` : undefined;
---

<BaseLayout
  lang={lang}
  title={title}
  description={description}
  path={`apps/${app.id}/`}
  image={image}
  jsonLd={appJsonLd(app, lang)}
>
  <AppLanding app={app} lang={lang} />
</BaseLayout>
