---
// ブログ一覧（日本語）: /blog/
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { useT } from "../../i18n/ui";

const lang = "ja";
const T = useT(lang);
const posts = (await getCollection("blog", (e) => e.data.lang === lang)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const fmt = (d: Date) => d.toLocaleDateString("ja-JP", { year: "numeric", month: "long", day: "numeric" });
---

<BaseLayout lang={lang} title={T("blog.title")} path="blog/">
  <section class="section">
    <div class="wrap">
      <div class="section__head">
        <span class="eyebrow">{T("blog.eyebrow")}</span>
        <h1 class="section__title display">{T("blog.title")}</h1>
        <p class="section__lead">{T("blog.intro")}</p>
      </div>
      <div class="blog-list">
        {posts.map((p) => (
          <a class="blog-card" href={`/blog/${p.data.key}/`}>
            <span class="eyebrow">{fmt(p.data.pubDate)}</span>
            <h2 class="blog-card__title">{p.data.title}</h2>
            <p class="blog-card__desc">{p.data.description}</p>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
