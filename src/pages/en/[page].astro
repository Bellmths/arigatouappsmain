---
// 固定ページ（英語）: /en/privacy/ /en/about/ /en/contact/
import BaseLayout from "../../layouts/BaseLayout.astro";
import { legal, legalTitles } from "../../data/legal";
import { t } from "../../i18n";

export function getStaticPaths() {
  return Object.keys(legal).map((slug) => ({ params: { page: slug }, props: { slug } }));
}

interface Props {
  slug: string;
}
const { slug } = Astro.props;
const lang = "en";
const title = t(legalTitles[slug], lang);
---

<BaseLayout lang={lang} title={title} path={`${slug}/`}>
  <section class="section">
    <div class="wrap">
      <h1 class="section__title display">{title}</h1>
      <div class="prose" set:html={t(legal[slug], lang)} />
    </div>
  </section>
</BaseLayout>
