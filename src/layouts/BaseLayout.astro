---
import "../styles/global.css";
import { site } from "../data/site";
import { t, langBase, LANGS, DEFAULT_LANG } from "../i18n";
import type { Lang } from "../i18n";
import { useT } from "../i18n/ui";
import { siteSeoTitle } from "../data/seo";
import { legalTitles, legalOrder } from "../data/legal";

interface Props {
  lang: Lang;
  title?: string;
  description?: string;
  /** 言語ベース以下のパス（例: "apps/timeaware"）。トップは "" */
  path?: string;
  /** OGP画像の絶対URL（無ければ og:image を出さない） */
  image?: string;
  /** schema.org JSON-LD オブジェクトの配列 */
  jsonLd?: unknown[];
}
const { lang, title, description, path = "", image, jsonLd = [] } = Astro.props;
const T = useT(lang);

// title があれば "<title> | ArigatouApps"、無ければサイト既定（キーワード入り）。
const pageTitle = title ? `${title} | ${site.name}` : t(siteSeoTitle, lang);
const metaDesc = description ?? t(site.description, lang);
const ogLocale = lang === "ja" ? "ja_JP" : "en_US";

// 言語別パス
const base = langBase(lang); // "/" or "/en/"
const canonical = `${site.url}${base}${path}`;
// 反対言語（切替ボタン用）— 同じページの別言語版へ
const other = LANGS.find((l) => l !== lang) ?? DEFAULT_LANG;
const otherHref = `${langBase(other)}${path}`;
// hreflang 相互リンク（x-default はデフォルト言語）
const alternates = LANGS.map((l) => ({ lang: l, href: `${site.url}${langBase(l)}${path}` }));
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- 初回のみブラウザ言語で言語ページへ自動誘導。手動切替の選択(localStorage)は尊重する。 -->
    <script is:inline>
      (function () {
        try {
          if (localStorage.getItem("lang")) return; // 明示的な選択があれば何もしない
          var path = location.pathname;
          var onEn = path === "/en" || path.indexOf("/en/") === 0;
          var isRoot = path === "/" || path === "/index.html";
          if (!onEn && isRoot) {
            var pref = (navigator.language || navigator.userLanguage || "").toLowerCase();
            // 日本語以外のブラウザは英語ページへ
            if (pref && pref.indexOf("ja") !== 0) {
              location.replace("/en/");
            }
          }
        } catch (e) {}
      })();
    </script>

    <meta name="description" content={metaDesc} />
    <title>{pageTitle}</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={canonical} />

    <!-- 多言語の相互リンク（SEO: 各言語版を検索エンジンに知らせる） -->
    {alternates.map((a) => (
      <link rel="alternate" hreflang={a.lang} href={a.href} />
    ))}
    <link rel="alternate" hreflang="x-default" href={`${site.url}${langBase(DEFAULT_LANG)}${path}`} />

    <!-- Open Graph / Twitter（SNS・AI検索のプレビュー用） -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={metaDesc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={ogLocale} />
    {image && <meta property="og:image" content={image} />}
    <meta name="twitter:card" content={image ? "summary_large_image" : "summary"} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={metaDesc} />
    {image && <meta name="twitter:image" content={image} />}

    <!-- Google AdSense -->
    <script
      async
      src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-2487274923157450"
      crossorigin="anonymous"
    ></script>

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=IBM+Plex+Mono:wght@400;500&family=Zen+Kaku+Gothic+New:wght@400;500;700&display=swap"
      rel="stylesheet"
    />

    {jsonLd.map((obj) => (
      <script type="application/ld+json" set:html={JSON.stringify(obj)} />
    ))}
  </head>
  <body>
    <header class="nav">
      <div class="wrap nav__inner">
        <a href={`${base}#top`} class="nav__brand">{site.name}</a>
        <nav class="nav__links">
          <a href={`${base}#projects`}>{T("nav.projects")}</a>
          <a href={`${base}#apps`}>{T("nav.apps")}</a>
          <a href={`${base}#faq`}>{T("nav.faq")}</a>
          <a href={`${base}#about`}>{T("nav.about")}</a>
          <a
            href={otherHref}
            class="nav__lang"
            data-set-lang={other}
            hreflang={other}
            aria-label={`Switch language to ${other.toUpperCase()}`}
          >{T("lang.switch")}</a>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="foot">
      <div class="wrap foot__inner">
        <div>
          <p class="foot__brand display">{site.name}</p>
          <p class="eyebrow">{t(site.tagline, lang)}</p>
        </div>
        <div class="foot__links eyebrow">
          {legalOrder.map((slug) => (
            <a href={`${base}${slug}/`}>{t(legalTitles[slug], lang)}</a>
          ))}
          {site.email && <a href={`mailto:${site.email}`}>{site.email}</a>}
        </div>
        <p class="foot__copy eyebrow">© {new Date().getFullYear()} {site.name}</p>
      </div>
    </footer>

    <!-- 言語切替を押したら選択を記憶し、以後は自動リダイレクトしない -->
    <script is:inline>
      document.querySelectorAll("[data-set-lang]").forEach(function (el) {
        el.addEventListener("click", function () {
          try {
            localStorage.setItem("lang", el.getAttribute("data-set-lang"));
          } catch (e) {}
        });
      });
    </script>

    <style>
      .nav {
        position: sticky;
        top: 0;
        z-index: 20;
        background: color-mix(in srgb, var(--paper) 86%, transparent);
        backdrop-filter: blur(8px);
        border-bottom: var(--border);
      }
      .nav__inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        padding-top: 14px;
        padding-bottom: 14px;
      }
      .nav__brand {
        font-family: var(--font-display);
        font-size: 1.4rem;
        letter-spacing: -0.01em;
      }
      .nav__links {
        display: flex;
        align-items: center;
        gap: 18px;
        font-family: var(--font-mono);
        font-size: 0.8rem;
        letter-spacing: 0.06em;
      }
      .nav__links a { color: var(--soft); }
      .nav__links a:hover { color: var(--ink); }
      .nav__lang {
        border: var(--border);
        border-radius: 999px;
        padding: 3px 12px;
        color: var(--ink) !important;
        letter-spacing: 0.04em;
      }
      .nav__lang:hover { background: var(--card); }

      .foot {
        margin-top: 40px;
        background: var(--card);
        border-top: var(--border);
      }
      .foot__inner {
        display: flex;
        flex-wrap: wrap;
        align-items: flex-end;
        justify-content: space-between;
        gap: 20px;
        padding-top: 40px;
        padding-bottom: 40px;
      }
      .foot__brand { font-size: 2rem; margin-bottom: 4px; }
      .foot__links { display: flex; gap: 16px; flex-wrap: wrap; }
      .foot__links a:hover { color: var(--ink); }
      .foot__copy { width: 100%; }
      @media (max-width: 560px) {
        .nav__links { gap: 12px; font-size: 0.72rem; }
      }
    </style>
  </body>
</html>
