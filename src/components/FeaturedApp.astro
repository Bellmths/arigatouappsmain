---
import type { AndroidAppWithUrl } from "../data/apps";
import type { Lang } from "../i18n";
import { t, tList, langBase } from "../i18n";
import { useT } from "../i18n/ui";
interface Props {
  app: AndroidAppWithUrl;
  lang: Lang;
}
const { app, lang } = Astro.props;
const T = useT(lang);
const features = app.features ? tList(app.features, lang) : [];
const detailHref = `${langBase(lang)}apps/${app.id}`;
// Google Play 公式バッジは言語別画像が用意されている（ja / en）。
const badgeLocale = lang === "ja" ? "ja" : "en";
const badgeSrc = `https://play.google.com/intl/${badgeLocale}/badges/static/images/badges/${badgeLocale}_badge_web_generic.png`;
---
<div class="feat">
  <div class="feat__body">
    <span class="eyebrow">{T("apps.featured")}</span>
    <h3 class="feat__name display">{app.name}</h3>
    <p class="feat__desc">{t(app.desc, lang)}</p>
    {features.length > 0 && (
      <ul class="feat__list">
        {features.map((f) => <li>{f}</li>)}
      </ul>
    )}
    <div class="feat__actions">
      <a class="feat__badge" href={app.playUrl} target="_blank" rel="noopener"
        aria-label={T("apps.getOnPlay")}>
        <img
          src={badgeSrc}
          alt={T("apps.getOnPlay")}
          height="56"
          loading="lazy"
        />
      </a>
      <a class="feat__detail" href={detailHref}>{T("card.details")} →</a>
    </div>
  </div>
  <div class="feat__art" aria-hidden="true">
    {app.icon ? <img class="feat__icon" src={app.icon} alt="" /> : <span>{app.emoji ?? "📱"}</span>}
  </div>
</div>

<style>
  .feat {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: 0;
    background: var(--card);
    border: var(--border);
    border-radius: var(--radius);
    overflow: hidden;
  }
  .feat__body { padding: clamp(24px, 4vw, 40px); }
  .feat__name { font-size: clamp(34px, 5vw, 52px); margin: 10px 0 12px; }
  .feat__desc { color: var(--soft); max-width: 46ch; }
  .feat__list {
    list-style: none;
    margin: 18px 0 24px;
    display: grid;
    gap: 10px;
  }
  .feat__list li {
    position: relative;
    padding-left: 26px;
    font-size: 0.92rem;
  }
  .feat__list li::before {
    content: "→";
    position: absolute;
    left: 0;
    font-family: var(--font-mono);
    color: var(--soft);
  }
  .feat__actions { display: flex; align-items: center; gap: 18px; flex-wrap: wrap; }
  .feat__detail { font-family: var(--font-mono); font-size: 0.82rem; }
  .feat__detail:hover { text-decoration: underline; }
  .feat__badge {
    display: inline-block;
    /* 公式バッジは透明の余白を含むため、左の視覚位置を合わせる */
    margin-left: -10px;
    transition: transform 0.12s;
  }
  .feat__badge:hover { transform: translateY(-2px); }
  .feat__badge img { height: 56px; width: auto; }
  .feat__art {
    border-left: var(--border);
    background: var(--c-cyan);
    display: grid;
    place-items: center;
    font-size: clamp(60px, 12vw, 120px);
    padding: 24px;
  }
  .feat__icon {
    width: clamp(96px, 18vw, 168px);
    height: auto;
    border-radius: 24px;
    border: var(--border);
  }
  @media (max-width: 720px) {
    .feat { grid-template-columns: 1fr; }
    .feat__art { border-left: none; border-top: var(--border); min-height: 160px; }
  }
</style>
